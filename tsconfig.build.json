{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "allowImportingTsExtensions": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist", "target", "tests", "scripts"]
}
