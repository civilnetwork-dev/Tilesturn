{
    "name": "tilesturn",
    "version": "0.1.0",
    "description": "Full-featured WebAssembly port and JavaScript/TypeScript SDK for cfsolve",
    "license": "MIT",
    "files": [
        "dist",
        "pkg",
        "profiles",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js"
        },
        "./wasm": {
            "types": "./pkg/cfsolve_wasm.d.ts",
            "import": "./pkg/cfsolve_wasm.js"
        },
        "./profiles/safari-26-ios": "./profiles/safari-26-ios.json",
        "./profiles/*": "./profiles/*"
    },
    "scripts": {
        "build:wasm": "bun scripts/build-wasm.ts",
        "build:sdk": "tsc -p tsconfig.build.json",
        "build": "bun run build:wasm && bun run build:sdk",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:rust": "cargo test -p cfsolve",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt -c oxfmt.config.ts",
        "format:check": "oxfmt -c oxfmt.config.ts --check",
        "format:rust": "cargo fmt --all",
        "format:rust:check": "cargo fmt --all -- --check",
        "lint": "oxlint -c oxlint.config.ts --fix",
        "lint:check": "oxlint -c oxlint.config.ts",
        "check": "oxfmt -c oxfmt.config.ts && oxlint -c oxlint.config.ts --fix && cargo fmt --all",
        "audit": "oxlint -c oxlint.config.ts && oxfmt -c oxfmt.config.ts --check && cargo fmt --all -- --check && tsc --noEmit"
    },
    "devDependencies": {
        "@types/bun": "^1.4.5",
        "@types/node": "^26.6.6",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1"
    }
}
